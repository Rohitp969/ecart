# Copy to .env and fill in real values. Never commit .env.
# On Render (https://ecart-8ijs.onrender.com) add the same keys under Environment.

# Server
# Local port. Render sets PORT itself, so don't add it there.
PORT=8000
# Optional: frontend address in email links (verification, welcome mail). Leave it unset and links open
# on the site the person used (localhost while developing, https://ecart-silk-six.vercel.app live).
# CLIENT_URL=

# MongoDB connection string
MONGO_URI=

# JWT signing secret: a long random string
SECRET_KEY=

# Email (signup verification, password reset codes, support mails). Pick one way to send:
# 1) Gmail over SMTP: works locally and on paid hosting.
#    MAIL_PASS must be a Gmail "App password" (Google Account → Security → App passwords)
MAIL_USER=
MAIL_PASS=
# 2) Brevo API (HTTPS): needed on Render's free plan, which blocks SMTP. Free at brevo.com →
#    SMTP & API → API keys. The sender (MAIL_FROM, else MAIL_USER) must be verified under Senders in Brevo.
BREVO_API_KEY=
MAIL_FROM=

# Cloudinary (product and profile images)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Razorpay (online payments)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
