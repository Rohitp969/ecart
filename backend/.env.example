# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=8000
# Frontend URL used in email links (verification, welcome mail). Optional in development.
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGO_URI=

# JWT signing secret: a long random string
SECRET_KEY=

# Gmail account that sends OTP / verification / support emails
# MAIL_PASS must be a Gmail "App password" (Google Account → Security → App passwords)
MAIL_USER=
MAIL_PASS=

# Cloudinary (product and profile images)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Razorpay (online payments)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
