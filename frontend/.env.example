# Copy to .env and fill in real values. Never commit .env.
# On Vercel (https://ecart-silk-six.vercel.app) add the same keys under Environment Variables.
# Every VITE_* value ends up in the browser bundle, so never put a secret here.

# Backend base URL (no trailing slash)
# Live: https://ecart-8ijs.onrender.com  ·  local: http://localhost:8000
VITE_API_URL=https://ecart-8ijs.onrender.com

# Razorpay public key id (the same key id as the backend's RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=
